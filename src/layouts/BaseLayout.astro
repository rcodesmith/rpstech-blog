---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <style is:global>
      :root {
        --bg: #1b2028;
        --fg: #dbe1e8;
        --fg-muted: #8b96a5;
        --accent: #e8a33d;
        --link: #e8a33d;
        --border: #323b48;
        --code-bg: #11151b;
        --font-head: 'Source Serif 4', serif;
        --font-body: 'Inter', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        color-scheme: dark;
      }

      body {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2rem 1rem;
        font-family: var(--font-body);
        line-height: 1.7;
        background: var(--bg);
        color: var(--fg);
      }

      nav {
        display: flex;
        gap: 1.25rem;
      }

      nav a {
        font-weight: 500;
      }

      hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 1.5rem 0;
      }

      a {
        color: var(--link);
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-head);
        font-weight: 600;
        line-height: 1.3;
        text-wrap: balance;
      }

      h1 {
        font-size: 1.6rem;
        margin: 0 0 0.5rem;
      }

      img {
        max-width: 100%;
        border-radius: 6px;
      }

      small {
        color: var(--fg-muted);
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.88em;
      }

      code:not(pre code) {
        background: var(--code-bg);
        padding: 0.15em 0.4em;
        border-radius: 4px;
      }

      pre {
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow-x: auto;
      }

      ul.post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      ul.post-list li {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--border);
      }

      ul.post-list li:last-child {
        border-bottom: none;
      }

      ul.post-list a {
        color: var(--fg);
      }

      ul.post-list a:hover {
        color: var(--accent);
      }

      p.tags {
        font-size: 0.85rem;
        color: var(--fg-muted);
      }

      p.tags .tag {
        display: inline-block;
        background: var(--code-bg);
        border: 1px solid var(--border);
        color: var(--accent);
        border-radius: 999px;
        padding: 0.15em 0.65em;
        margin: 0.15em 0.3em 0.15em 0;
        font-size: 0.8rem;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a href="/about/">About</a>
    </nav>
    <hr />
    <slot />
  </body>
</html>
