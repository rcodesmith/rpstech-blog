---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\/index$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Ron Smith`}>
  <article>
    <h1>{post.data.title}</h1>
    {post.data.draft && <p><em>(draft — never published)</em></p>}
    {post.data.date && (
      <p>
        <small>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</small>
      </p>
    )}
    <Content />
    {post.data.tags.length > 0 && (
      <p>Tags: {post.data.tags.join(', ')}</p>
    )}
  </article>
</BaseLayout>
