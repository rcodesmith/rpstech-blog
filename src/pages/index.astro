---
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Ron Smith">
  <h1>Ron Smith</h1>
  <p>
    I'm a software developer. Lately I've been working on agentic development and on applying
    generative AI to real products. I've been writing here since 2007, so the older posts are a
    bit of a time capsule.
  </p>

  <h2>Recent posts</h2>
  <PostList posts={posts.slice(0, 5)} />
  <p><a href="/blog/">All {posts.length} posts →</a></p>
</BaseLayout>
